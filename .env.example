# Copy to .env.local (never commit real secrets). Validated by src/lib/env.ts.

# --- Client (safe to expose) ---
NEXT_PUBLIC_APP_NAME="Cisco Wi-Fi Planner"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# --- Server (optional in the client-persisted MVP; required once Postgres/Auth
#     and object storage are wired) ---
# DATABASE_URL="postgresql://cwp:cwp@localhost:5432/cwp"
# AUTH_SECRET="replace-with-a-long-random-secret-min-16-chars"

# Object storage (signed URLs for private floor-plan files and report images)
# STORAGE_BUCKET="cwp-floorplans"
# STORAGE_REGION="us-east-1"
# STORAGE_ENDPOINT=""            # optional S3-compatible endpoint

# Observability (optional pluggable sinks)
# LOG_LEVEL="info"
# ERROR_TRACKING_DSN=""

# Rate limiting (expensive simulate/export endpoints)
# RATE_LIMIT_WINDOW_MS="60000"
# RATE_LIMIT_MAX="30"

# NOTE: No default development credentials may be usable in production.
